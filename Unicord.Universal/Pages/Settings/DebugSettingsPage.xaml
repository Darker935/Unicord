<Page
    x:Class="Unicord.Universal.Pages.Settings.DebugSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unicord.Universal.Pages.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:SettingsControl"
    xmlns:lib="using:Microsoft.UI.Xaml.Controls"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel>

        <lib:InfoBar
            x:Name="StatusBar"
            Margin="0,4"
            IsClosable="True"
            IsOpen="False"
            Title="" />

        <StackPanel Margin="4,8,4,16">
            <TextBlock Text="Trace logs"
                       Style="{ThemeResource BaseTextBlockStyle}"/>
            <TextBlock Text="Unicord traces to ETW, which buffers events in memory. Nothing reaches the disk until a session is saved, so save before collecting a trace."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Opacity="0.75"/>
            <TextBlock Text="Saved traces are filed under Logs\&lt;time&gt;-&lt;process id&gt;. The single small .etl left directly in Logs is the session being recorded right now; it is moved into the folder the next time you save."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Opacity="0.75"/>
        </StackPanel>

        <settings:SettingsBlockControl
            Title="Save logs now"
            Description="Closes the current trace session, writes it to disk and starts a new one. Unicord keeps running.">
            <settings:SettingsBlockControl.Icon>
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74E;"/>
            </settings:SettingsBlockControl.Icon>
            <Button x:Name="SaveLogsButton" Content="Save" Click="SaveLogsButton_Click" MinWidth="120"/>
        </settings:SettingsBlockControl>

        <settings:SettingsBlockControl
            x:Name="LogsFolderBlock"
            Title="Saved logs"
            Description="Counting...">
            <settings:SettingsBlockControl.Icon>
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE838;"/>
            </settings:SettingsBlockControl.Icon>
            <Button x:Name="OpenLogsButton" Content="Open folder" Click="OpenLogsButton_Click" MinWidth="120"/>
        </settings:SettingsBlockControl>

        <settings:SettingsBlockControl
            Title="Clear saved logs"
            Description="Deletes every trace already written to disk. The session currently being recorded is kept.">
            <settings:SettingsBlockControl.Icon>
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;"/>
            </settings:SettingsBlockControl.Icon>
            <Button x:Name="ClearLogsButton" Content="Clear" Click="ClearLogsButton_Click" MinWidth="120"/>
        </settings:SettingsBlockControl>

        <StackPanel Margin="4,16,4,8">
            <TextBlock Text="Reading a trace"
                       Style="{ThemeResource BaseTextBlockStyle}"/>
            <TextBlock Text="Traces are .etl files. Decode one with: tracerpt &lt;file&gt;.etl -o dump.xml -of XML -y"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="True"
                       Opacity="0.75"/>
        </StackPanel>

    </StackPanel>
</Page>
